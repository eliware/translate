{
  "name": "@eliware/translate",
  "version": "13.0.0",
  "type": "module",
  "description": "A tool for translating locale files for discord apps built on @eliware/discord",
  "keywords": [
    "translate",
    "translation",
    "discord",
    "locales",
    "localization",
    "eliware",
    "nodejs"
  ],
  "private": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "bin": {
    "translate": "bin/translate.mjs"
  },
  "files": [
    "src/",
    "docs/",
    "README.md",
    "AGENTS.md",
    "LICENSE",
    "RELEASE_NOTES.md",
    "bin/",
    "specs/",
    "prompt.json",
    "prompt-commands.json",
    ".env.example"
  ],
  "scripts": {
    "test": "eliware-test",
    "lint": "eliware-test --lint",
    "format": "eliware-test --format",
    "format:check": "eliware-test --format-check",
    "audit": "eliware-test --audit",
    "pack": "eliware-test --pack"
  },
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@eliware/common": "^12.0.1",
    "@eliware/openai": "^12.0.0",
    "dotenv": "^18.0.8"
  },
  "devDependencies": {
    "@eliware/test": "^13.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.mjs"
    ],
    "collectCoverageFrom": [
      "src/**/*.mjs"
    ],
    "coverageReporters": [
      "text",
      "json-summary"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 100,
        "functions": 100,
        "lines": 100,
        "statements": 100
      }
    }
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "useTabs": false,
    "semi": true,
    "singleQuote": false,
    "quoteProps": "as-needed",
    "jsxSingleQuote": false,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "proseWrap": "preserve",
    "endOfLine": "lf"
  },
  "author": "Eliware <eliware@eliware.org>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eliware/translate.git"
  },
  "homepage": "https://github.com/eliware/translate#readme",
  "bugs": {
    "url": "https://github.com/eliware/translate/issues"
  },
  "eliware": {
    "id": "E-1230",
    "apply": [
      "general",
      "application",
      "cli",
      "npm-published"
    ]
  }
}
